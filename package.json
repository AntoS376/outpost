{
  "name": "outpost",
  "version": "0.1.0",
  "description": "Offline knowledge server for macOS: library, local AI, maps and notes in one browser UI.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_USE_SYSTEM_CA=1 tsx watch src/main.ts",
    "build": "tsc -p . && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "start": "NODE_USE_SYSTEM_CA=1 node dist/main.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "postinstall": "node scripts/build-client.mjs",
    "demo": "node --import tsx test/demo.ts"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@protomaps/basemaps": "^5.0.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "maplibre-gl": "^6.16.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "mgrs": "^2.2.0",
    "playwright-core": "^1.64.1",
    "qrcode-generator": "2.0.4",
    "suncalc": "^2.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

{
  "version": 1,
  "apps": [
    {
      "id": "files",
      "name": "File Browser",
      "description": "Upload, download, rename and share files in your Outpost files folder, from any device that can sign in to Outpost.",
      "homepage": "https://github.com/filebrowser/filebrowser",
      "license": "Apache-2.0",
      "download": {
        "arm64": {
          "url": "https://github.com/filebrowser/filebrowser/releases/download/v2.63.23/darwin-arm64-filebrowser.tar.gz",
          "sha256": "b7d451cb6e31497d649895d410df5e2786fe23c58b6c2341073c967388959f8e"
        },
        "x64": {
          "url": "https://github.com/filebrowser/filebrowser/releases/download/v2.63.23/darwin-amd64-filebrowser.tar.gz",
          "sha256": "6117f440538d442e7ef831749f6ca085f9928c27fc4c62d9944c96b2d20333a1"
        },
        "extract": "filebrowser"
      },
      "bin": "{home}/bin/filebrowser",
      "args": [
        "--address",
        "127.0.0.1",
        "--port",
        "{port}",
        "--root",
        "{home}/files",
        "--baseURL",
        "{prefix}",
        "--database",
        "{data}/filebrowser.db",
        "--noauth"
      ],
      "folders": [
        "{home}/files"
      ],
      "port": 8095,
      "prefix": true,
      "health": "/health",
      "members": "read",
      "note": "Uses Outpost's sign-in instead of its own (--noauth). Members can browse and download; only admins can upload, rename or delete."
    },
    {
      "id": "music",
      "name": "Navidrome",
      "description": "Your music and audiobooks, played in the browser on any device that can sign in to Outpost.",
      "homepage": "https://www.navidrome.org",
      "license": "GPL-3.0",
      "download": {
        "arm64": {
          "url": "https://github.com/navidrome/navidrome/releases/download/v0.64.2/navidrome_0.64.2_darwin_arm64.tar.gz",
          "sha256": "8b0a7798001453719ad50c12f7025a6044546c4a3568efe51feb296681f29956"
        },
        "x64": {
          "url": "https://github.com/navidrome/navidrome/releases/download/v0.64.2/navidrome_0.64.2_darwin_amd64.tar.gz",
          "sha256": "bc872847dcd1c0d760bb9b8730f2a3c876e0ff0679e5440755c37697f2804a23"
        },
        "extract": "navidrome"
      },
      "bin": "{home}/bin/navidrome",
      "args": [
        "--address",
        "127.0.0.1",
        "--port",
        "{port}",
        "--musicfolder",
        "{home}/files/Music",
        "--datafolder",
        "{data}",
        "--baseurl",
        "{prefix}"
      ],
      "folders": [
        "{home}/files/Music"
      ],
      "port": 8096,
      "prefix": true,
      "health": "/app/",
      "members": "write",
      "note": "Plays what's in the Music folder of File Browser (~/Outpost/files/Music). Navidrome has its own accounts: the first person to open it creates its admin. Converting formats on the fly needs ffmpeg (brew install ffmpeg); without it, files play as they are."
    }
